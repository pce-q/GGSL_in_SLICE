runmode
	reference 3 87.3031153 -62.0767410
	image    1 arcs.dat
	inverse   3 0.5 400
        verbose 0
	end
image
	multfile     1 arcs.dat
	form         -1
	mult_wcs     3
    z_m_limit  1 3.0 1 0.5 7.0 0.1000
    z_m_limit  1 7.0 1 0.5 7.0 0.1000
    z_m_limit  1 8.0 1 0.5 7.0 0.1000
	newton       1
	sigposArcsec 0.3
	end
grid
	profile     128
	polar       0
	nlens       3
	nlens_opt   0
	end
potfile
    filein  3  galcat.cat
    type    81
    zlens   0.3755
    corekpc 0.15
    mag0    20.750000
    sigma   1 50.0 350.0 0.1
    cutkpc  1 1.0 150.0 0.1
    slope   0 4.
    vdslope 0 4.
    end


cline
	nplan    1 3.0
	dmax     100.000
        algorithm   MARCHINGSQUARES
        limitHigh   1.0
        limitLow    0.100
	end
grande
	iso         0 0 0.000 0.000 0.000 
	name        best 
	profile     0 0 
	contour     1 0 
	large_dist  0.300 
	end	
cosmology
	model   1 
	H0      70.000 
	omegaM  0.300 
	omegaX  0.700 
	omegaK  0. 
	wX      -1.000 
	wa      0.000 
	end	
cosmolimit
	omegaM  0 0.000 0.000 
	omegaX  0 0.000 0.000 
	wX      0 0.000 0.000 
	wa      0 0.000 0.000 
	end	
field
	xmin    -20.000 
	xmax    20.000 
	ymin    -20.000 
	ymax    20.000 
	end	
finish
