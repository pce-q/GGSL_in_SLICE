
runmode
    reference 3 10.852708 -20.628215
    inverse   3 0.5 200
    verbose 1
    end
image
    multfile     1 arcs.dat
    forme        -2
    mult_wcs     3
    z_m_limit  1   2  3  0.9  0.2  0.1
    z_m_limit  1  A3a  1 0.8 2.0 0.1
    z_m_limit  1  A3b 1 0.8 2.0 0.1
    z_m_limit  1  A4a 1  1.0 4.0 0.1
    z_m_limit  1  A4b 1  1.0 4.0 0.1
    z_m_limit  1   A5a 1  1.0  3.0  0.1
    z_m_limit  1   A5b 1  1.0  3.0  0.1
    z_m_limit  1   50 1  0.5  3.0  0.1
    z_m_limit  1   7  1  0.5  3.0 0.1
    z_m_limit  1   8  3  0.6  0.3  0.1
    z_m_limit  1   9  1  1.0  5.0  0.1
    sigposArcsec 0.6
    end
grille
    nombre      128
    polaire     0
    nlentille   200
    nlens_opt   2
    end
potentiel O1 # cluster: PIEMD
	profil       81
	x_centre     -5.00
	y_centre     40.000
	ellipticite     0.5
	angle_pos       90
	core_radius_kpc    150.0
	cut_radius_kpc     1500.000
	v_disp     1000
	z_lens     0.2924
	end
limit O1
    x_centre         1 -10.000 -2.000 0.010
    y_centre         1  35.000 43.000 0.010
    ellipticite      1  0.0 0.9 0.001
    angle_pos        1  0.0 180.000 0.100
    core_radius_kpc  1  10.  400.  0.10
    cut_radius_kpc   0  100. 1000. 0.10
    v_disp           1  500. 2000. 0.10        
    end
potentiel O2 #: cluster south
	profil     81
	x_centre     5.000
	y_centre     15.000
	ellipticite     0.50
	angle_pos       90
	core_radius_kpc     30.000
	cut_radius_kpc     1500
	v_disp     1000
	z_lens     0.2924
	end
limit O2
    x_centre         1  0.000 10.000 0.010
    y_centre         1  10.000 20.000 0.010
    ellipticite      1  0.0 0.9 0.001
    angle_pos        1  0.0 180.000 0.100
    core_radius_kpc  1  1.  200.  0.10
    cut_radius_kpc   0  100. 1000. 0.10
    v_disp           1  300. 2000. 0.10        
    end
