potfile
     filein  3 galcat.cat
     zlens   0.2924
     corekpc 0.0
     type    81
     mag0    18.32
#        sigma   1 50 150
#        cutkpc  1 3 50
     sigma   0 80 50 200
     cutkpc  0 20 3 200
     slope   0 4.
     vdslope 0 4.
     end
cline
    nplan    3 1.000 2.000 4.000
    dmax     100.000
        algorithm marchingsquares
        limitHigh   2.000
        limitLow    1.000
    end
grande
    iso         0 0 0.000 0.000 0.000
    name        best
    profil      0 0
    contour     1 0
    large_dist  0.300
    end
cosmologie
    H0         70.000
    omegaM     0.300
    omegaX     0.700
    wX         -1.000
    end
champ
     xmax    100
     xmin   -100
     ymax    100
     ymin   -100
	end
fini
