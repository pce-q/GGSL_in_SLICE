#pylenstool modification 20260831135523
#reference is origin/lens (RA Dec of GL.1 / primary deflector)
# Scaffold template — English keywords (same family as Lenstool best.par output).
# Edit inverse / forme / sigpos by hand before: lenstool input.par
# Optional source-z prior under image:
#   z_m_limit  1 1 1 0.5 7.0 0.1000
#
# Secondary galaxies (GL.2, …) are added by scaffold_model.py as potential O2…
# The commented block below is *external shear* (profile 14), not a second galaxy.
runmode
	reference   3 181.5652550 -8.8060839 
	inverse     3 0.500000 400 
	end	
image
	multfile        1 arcs.dat 
	newton          1 
	forme           -1 
	mult_wcs        1 
	sigposArcsec    0.500000 
	end	
grille
	nombre      128 
	polaire     0 
	nlentille   3 
	nlens_opt   3 
	end	
source
	z_source    0.4514 
	end	
potential	O1	
	profile         81 
	x_centre        0 
	y_centre        0 
	ellipticity     0.165718 
	angle_pos       24.793539 
	core_radius_kpc 5.000 
	cut_radius_kpc  100.000 
	v_disp          100.0 
	z_lens          0.4414 
	end	
limit	O1	
	x_centre        0 -5 5 0.000 
	y_centre        0 -5 5 0.000 
	ellipticity     1 0.0 0.80 0.000 
	angle_pos       1 -90 90 0.100 
	core_radius_kpc 1 0.01 50 0.010 
	v_disp          1 10.0 500.0 0.000 
	end	
potential	O2	
	profile         81 
	x_centre        -5.024347 
	y_centre        4.652640 
	ellipticity     0.235699 
	angle_pos       0.000000 
	core_radius_kpc 5.0 
	cut_radius_kpc  100.0 
	v_disp          100.0 
	z_lens          0.4414 
	end	
limit	O2	
	x_centre        0 -5 5 0.000 
	y_centre        0 -5 5 0.000 
	ellipticity     1 0.0 0.80 0.000 
	angle_pos       1 -90 90 0.100 
	core_radius_kpc 1 0.01 50 0.010 
	v_disp          1 10.0 500.0 0.000 
	end	
potential	S1	
	profile     14 
	gamma       1 
	angle_pos   0 
	kappa       0 
	z_lens      0.4414 
	end	
limit	S1	
	gamma       1 0.0 1.2 0.0 
	angle_pos   1 -90 90 0.100 
	end	
cline
	nplan       0 
	dmax        40.000 
	algorithm   MARCHINGSQUARES 
	limitHigh   10.0 
	limitLow    3.000 
	end	
grande
	iso         0 0 0.000 0.000 0.000 
	name        best 
	profile     0 0 
	contour     1 0 
	large_dist  0.300 
	end	
cosmology
	model   1 
	H0      70.000 
	omegaM  0.300 
	omegaX  0.700 
	omegaK  0. 
	wX      -1.000 
	wa      0.000 
	end	
cosmolimit
	omegaM  0 0.000 0.000 
	omegaX  0 0.000 0.000 
	wX      0 0.000 0.000 
	wa      0 0.000 0.000 
	end	
field
	xmin    -20.000 
	xmax    20.000 
	ymin    -20.000 
	ymax    20.000 
	end	
finish